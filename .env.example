# Copy to .env and adjust if needed:  cp .env.example .env
# Never commit .env (credentials stay local).

# Vector store backend: "chroma" or "pgvector"
VECTOR_STORE=chroma

# ChromaDB settings
CHROMA_DIR=data/chromadb

# --- Postgres / pgvector (docker-compose.yml) ---
POSTGRES_USER=tpi
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=tpi_vectors
POSTGRES_PORT=5432

# Used by Python (SQLAlchemy / Alembic). Host is localhost when connecting from your Mac.
DATABASE_URL=postgresql+psycopg://tpi:change-me-local-only@localhost:5432/tpi_vectors

# pgvector settings (used by vector_store/factory.py when VECTOR_STORE=pgvector)
PG_CONNECTION_STRING=postgresql+psycopg://tpi:change-me-local-only@localhost:5432/tpi_vectors

# Parent directory containing one subfolder per company
PDF_SOURCE_DIR=data/pdfs

# PDF file pattern
PDF_GLOB=*.pdf

# Pipeline output directory
OUTPUT_DIR=data/interim

# Collection name for vector store
COLLECTION_NAME=tpi_vectors

# Models
EMBEDDING_MODEL=sentence-transformers/multi-qa-MiniLM-L6-cos-v1
RERANKING_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
GENERATION_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# HuggingFace cache (set to shared mount on Nuvolos)
HF_HOME=

# HuggingFace token (optional; reduces rate limits on model downloads)
# HF_TOKEN=hf_...
